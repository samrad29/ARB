# SQLite database path. Relative paths are resolved from the project root.
DATABASE_PATH=data/prediction_markets.db

# High-interest HTTP poll interval when WebSockets are unavailable.
# Not an optimum — used only for the watchlist fallback.
POLL_INTERVAL_SECONDS=2
POLL_CANDIDATE_SECONDS=15
POLL_INACTIVE_SECONDS=300

# Market discovery (metadata + matching). Infrequent on purpose.
DISCOVERY_INTERVAL_SECONDS=300

# Persist in-memory books to SQLite this often. Not every WebSocket tick.
ORDERBOOK_SNAPSHOT_INTERVAL_SECONDS=2

# HTTP
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=5

# Exchanges: comma-separated. V1 supports kalshi,polymarket.
ENABLED_EXCHANGES=kalshi,polymarket

# Official public API bases (no trading keys required).
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Optional. Kalshi WebSockets require API-key handshake per official docs.
# Leave blank to use adaptive HTTP polling for the Kalshi watchlist.
# KALSHI_API_KEY=
# KALSHI_PRIVATE_KEY_PATH=

# 0 = unlimited discovery. Watchlist sizes still cap high-frequency work.
MAX_MARKETS_PER_EXCHANGE=0
MAX_HIGH_WATCHLIST=80
MAX_CANDIDATE_WATCHLIST=120
MIN_WATCH_LIQUIDITY=10

# Matching thresholds (false positives are worse than false negatives).
ORDERBOOK_MIN_MATCH_SCORE=0.55
MATCH_CANDIDATE_MIN_SCORE=0.55
MATCH_HIGH_CONFIDENCE_MIN_SCORE=0.82

LOG_LEVEL=INFO
LOG_JSON=false
